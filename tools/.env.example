# Copy to .env (same directory as sync-archive-media.py) and fill in real
# credentials. .env is git-ignored - never commit real keys.

# Generic regional endpoint - NOT the bucket-specific vhost URL from the Linode
# dashboard (boto3 would prefix the bucket name onto it a second time)
OLD_S3_ENDPOINT=https://eu-central-1.linodeobjects.com
OLD_S3_REGION=eu-central-1
OLD_S3_BUCKET=schooner-archive
OLD_S3_PREFIX=archive
OLD_S3_ACCESS_KEY=
OLD_S3_SECRET_KEY=

NEW_S3_ENDPOINT=https://s3.dwal.in
NEW_S3_REGION=garage
NEW_S3_BUCKET=archive.seapractic.ru
NEW_S3_PREFIX=media
NEW_S3_ACCESS_KEY=
NEW_S3_SECRET_KEY=
