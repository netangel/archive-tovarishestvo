        {
            "Category": "Боты и мотоботы",
            "Pattern": "(?-i:Бот)|мотобот|фангсбот|дрифтер|касатк|мотодот"
        },
        {
            "Category": "Ёлы",
            "Pattern": "ёл[аыеу]|(?:моторн|парусн)\\w{0,4}(?-i:Ел)[аыеу]"
